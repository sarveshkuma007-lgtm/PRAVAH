# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# Client-side configuration (optional for custom live APIs)
VITE_GEMINI_API_KEY=""
VITE_MAPS_API_KEY=""
VITE_WEATHER_API_KEY=""
VITE_API_BASE_URL="/api"

